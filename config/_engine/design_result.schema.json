{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/dataval/design_result.schema.json",
  "title": "dataval design result (design mode)",
  "type": "object",
  "additionalProperties": false,
  "required": ["logical_design", "physical_design", "narrative"],
  "properties": {
    "logical_design": {
      "type": "object",
      "required": ["business_context", "domain_boundary", "entities",
                   "metric_contracts", "cross_domain_dependencies"],
      "properties": {
        "business_context": {"type": "string", "minLength": 1},
        "domain_boundary": {
          "type": "object",
          "required": ["statement"],
          "properties": {
            "statement": {"type": "string", "minLength": 1},
            "owns": {"type": "array", "items": {"type": "string"}},
            "references": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "entity": {"type": "string"},
                  "authority": {"type": "string"},
                  "note": {"type": "string"}
                }
              }
            }
          }
        },
        "metric_contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "definition"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "definition": {"type": "string", "minLength": 1},
              "grain": {"type": "string"},
              "source": {"type": "string"},
              "caveats": {"type": "string"}
            }
          }
        },
        "cross_domain_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["domain", "entity"],
            "properties": {
              "domain": {"type": "string", "minLength": 1},
              "entity": {"type": "string", "minLength": 1},
              "direction": {"enum": ["upstream", "downstream"]},
              "via": {"type": "string"},
              "description": {"type": "string"}
            }
          }
        },
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "kind": {"type": "string"},
              "description": {"type": "string"},
              "grain": {"type": "string"},
              "attributes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "description": {"type": "string"},
                    "business_key": {"type": "boolean"}
                  }
                }
              }
            }
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {"type": "string"},
              "to": {"type": "string"},
              "cardinality": {"enum": ["1:1", "N:1", "N:M"]},
              "description": {"type": "string"}
            }
          }
        }
      }
    },
    "physical_design": {
      "type": "object",
      "required": ["tables"],
      "properties": {
        "overview": {"type": "string"},
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "keys", "design_decisions"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "layer": {"enum": ["base", "intermediate", "wide"]},
              "keys": {
                "type": "object",
                "required": ["business_key", "description"],
                "properties": {
                  "business_key": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "description": {"type": "string", "minLength": 1},
                  "join_keys": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["column"],
                      "properties": {
                        "column": {"type": "string", "minLength": 1},
                        "references": {"type": "string"},
                        "note": {"type": "string"}
                      }
                    }
                  }
                }
              },
              "engine": {"type": "string"},
              "order_by": {"type": "string"},
              "partition_by": {"type": "string"},
              "comment": {"type": "string"},
              "ddl": {"type": "string"},
              "design_decisions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["decision", "rationale"],
                  "properties": {
                    "decision": {"type": "string", "minLength": 1},
                    "rationale": {"type": "string", "minLength": 1}
                  }
                }
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "type": {"type": "string"},
                    "nullable": {"type": "boolean"},
                    "comment": {"type": "string"},
                    "source": {"type": "string"}
                  }
                }
              }
            }
          }
        },
        "table_relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": {"type": "string", "minLength": 1},
              "to": {"type": "string", "minLength": 1},
              "cardinality": {"enum": ["1:1", "N:1", "N:M"]},
              "kind": {"type": "string"},
              "note": {"type": "string"}
            }
          }
        },
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "narrative": {
      "type": "object",
      "required": ["tldr", "why", "tradeoffs", "how_to_use"],
      "properties": {
        "tldr": {"type": "string", "minLength": 1},
        "why": {"type": "string", "minLength": 1},
        "how_design_thinks": {"type": "string"},
        "tradeoffs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["chose", "because"],
            "properties": {
              "chose": {"type": "string", "minLength": 1},
              "instead_of": {"type": "string"},
              "because": {"type": "string", "minLength": 1}
            }
          }
        },
        "how_to_use": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["scenario", "guidance"],
            "properties": {
              "scenario": {"type": "string", "minLength": 1},
              "guidance": {"type": "string", "minLength": 1}
            }
          }
        },
        "pitfalls": {"type": "array", "items": {"type": "string"}},
        "lessons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "draft_ddl": {"type": "string", "minLength": 1},
    "open_questions": {
      "type": "array",
      "items": {
        "anyOf": [
          {"type": "string"},
          {
            "type": "object",
            "required": ["question"],
            "properties": {
              "question": {"type": "string", "minLength": 1},
              "proposed_answer": {"type": "string"}
            }
          }
        ]
      }
    }
  }
}
