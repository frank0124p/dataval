{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.internal/dataval/design_result.schema.json",
  "title": "dataval design result (design mode)",
  "type": "object",
  "additionalProperties": false,
  "required": ["logical_design", "physical_design", "draft_ddl"],
  "properties": {
    "logical_design": {
      "type": "object",
      "required": ["overview", "entities"],
      "properties": {
        "overview": {"type": "string", "minLength": 1},
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "description": {"type": "string"},
              "grain": {"type": "string"},
              "attributes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "description": {"type": "string"},
                    "business_key": {"type": "boolean"}
                  }
                }
              }
            }
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {"type": "string"},
              "to": {"type": "string"},
              "cardinality": {"enum": ["1:1", "N:1", "N:M"]},
              "description": {"type": "string"}
            }
          }
        }
      }
    },
    "physical_design": {
      "type": "object",
      "required": ["tables"],
      "properties": {
        "overview": {"type": "string"},
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "engine": {"type": "string"},
              "order_by": {"type": "string"},
              "partition_by": {"type": "string"},
              "comment": {"type": "string"},
              "columns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "type": {"type": "string"},
                    "nullable": {"type": "boolean"},
                    "comment": {"type": "string"}
                  }
                }
              }
            }
          }
        },
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "draft_ddl": {"type": "string", "minLength": 1},
    "open_questions": {"type": "array", "items": {"type": "string"}}
  }
}
